{
  "name": "kumi",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "gen:gone": "node tools/gen_gone.ts",
    "test:sweep": "node tools/sweep_test_dbs.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/manager/tsconfig.json && tsc -p apps/member/tsconfig.json",
    "openpadel": "node apps/server/src/cli.ts",
    "kumi": "node apps/server/src/cli.ts",
    "test": "node --test --test-concurrency=4 'packages/*/test/*.test.ts' 'apps/*/test/*.test.ts'"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
