# Copy to .env next to compose.yaml, fill it in, and never commit it.
KUMI_HOST=app.yourclub.com            # the members' app; staff use staff.app.yourclub.com
KUMI_DB_PASSWORD=                     # make one: openssl rand -hex 24
KUMI_PRACTICE=1                       # practice mode: real email only to KUMI_MAIL_TEST_TO
KUMI_SECRET_KEY=                      # make one: head -c 32 /dev/urandom | base64  (seals the secrets Kumi keeps)
KUMI_BACKUP_KEY=                      # make one the same way, and keep a copy away from this machine
# Offsite backups (docs/setup/accounts/offsite-backups.md):
# KUMI_OFFSITE_ENDPOINT=  KUMI_OFFSITE_BUCKET=  KUMI_OFFSITE_ACCESS_KEY_ID=  KUMI_OFFSITE_SECRET_ACCESS_KEY=  KUMI_OFFSITE_REGION=auto
# KUMI_RESEND_API_KEY=  KUMI_MAIL_FROM="Your Club <hello@mail.yourclub.com>"  KUMI_MAIL_TEST_TO=you@example.com  KUMI_RESEND_WEBHOOK_SECRET=whsec_...
# KUMI_TWILIO_ACCOUNT_SID=  KUMI_TWILIO_AUTH_TOKEN=  KUMI_TWILIO_MESSAGING_SERVICE_SID=  KUMI_SMS_TEST_TO=+15035550123
# Ask the club (docs/setup/accounts/ask-the-club.md): KUMI_TYPESAFE_API_KEY=  KUMI_ANTHROPIC_API_KEY=
# KUMI_STRIPE_SECRET_KEY=  KUMI_STRIPE_PUBLISHABLE_KEY=  KUMI_STRIPE_WEBHOOK_SECRET=
# KUMI_PLAYTOMIC_CLIENT_ID=  KUMI_PLAYTOMIC_SECRET=  KUMI_PLAYTOMIC_TENANT_ID=
