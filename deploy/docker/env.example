# Copy to .env next to compose.yaml, fill it in, and never commit it.
OPENPADEL_HOST=app.yourclub.com            # the members' app; staff use staff.app.yourclub.com
OPENPADEL_DB_PASSWORD=                     # make one: openssl rand -hex 24
OPENPADEL_PRACTICE=1                       # practice mode: real email only to OPENPADEL_MAIL_TEST_TO
OPENPADEL_SECRET_KEY=                      # make one: head -c 32 /dev/urandom | base64  (seals the secrets Kumi keeps)
OPENPADEL_BACKUP_KEY=                      # make one the same way, and keep a copy away from this machine
# Offsite backups (docs/setup/accounts/offsite-backups.md):
# OPENPADEL_OFFSITE_ENDPOINT=  OPENPADEL_OFFSITE_BUCKET=  OPENPADEL_OFFSITE_ACCESS_KEY_ID=  OPENPADEL_OFFSITE_SECRET_ACCESS_KEY=  OPENPADEL_OFFSITE_REGION=auto
# OPENPADEL_RESEND_API_KEY=  OPENPADEL_MAIL_FROM="Your Club <hello@mail.yourclub.com>"  OPENPADEL_MAIL_TEST_TO=you@example.com  OPENPADEL_RESEND_WEBHOOK_SECRET=whsec_...
# OPENPADEL_TWILIO_ACCOUNT_SID=  OPENPADEL_TWILIO_AUTH_TOKEN=  OPENPADEL_TWILIO_MESSAGING_SERVICE_SID=  OPENPADEL_SMS_TEST_TO=+15035550123
# Ask the club (docs/setup/accounts/ask-the-club.md): OPENPADEL_TYPESAFE_API_KEY=  OPENPADEL_ANTHROPIC_API_KEY=
# OPENPADEL_STRIPE_SECRET_KEY=  OPENPADEL_STRIPE_PUBLISHABLE_KEY=  OPENPADEL_STRIPE_WEBHOOK_SECRET=
# OPENPADEL_PLAYTOMIC_CLIENT_ID=  OPENPADEL_PLAYTOMIC_SECRET=  OPENPADEL_PLAYTOMIC_TENANT_ID=
